VITE_API_MODE=                     # "mock" (MSW/Prism) or "supabase" (auto-detected when Supabase keys are set)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=     # Supabase publishable key (preferred; falls back to VITE_SUPABASE_ANON_KEY)
VITE_SUPABASE_ANON_KEY=            # legacy publishable anon key; RLS is what protects the data
VITE_API_BASE_URL=                 # optional base URL override (e.g. http://127.0.0.1:4010 for Prism)
VITE_SITE_URL=                     # e.g. http://localhost:5173 — used for OAuth redirect URLs